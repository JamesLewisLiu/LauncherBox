<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LauncherBox" Width="1160" Height="760" MinWidth="660" MinHeight="440" WindowStartupLocation="CenterScreen" Background="#08151F" Foreground="#EFF4EF" FontFamily="Segoe UI" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#D5E2E2"/><Setter Property="Background" Value="#122630"/><Setter Property="BorderBrush" Value="#35505B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,9"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="#A5F4DF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="White"/><Setter TargetName="frame" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="frame" Property="Opacity" Value=".72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="frame" Property="Opacity" Value=".42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="28,14,28,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="#253944" BorderThickness="0,0,0,1" Padding="0,0,0,12"><DockPanel LastChildFill="False">
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center"><Viewbox Width="31" Height="31"><Canvas Width="32" Height="32"><Ellipse Width="28" Height="28" Fill="#A1EBD2" Canvas.Left="1" Canvas.Top="3"/><Ellipse Width="23" Height="23" Fill="#08151F" Canvas.Left="10" Canvas.Top="-1"/><Path Fill="#F2BD8D" Data="M23,5 L24.4,8.6 28,10 24.4,11.4 23,15 21.6,11.4 18,10 21.6,8.6Z"/></Canvas></Viewbox><TextBlock Margin="9,0,0,0" FontWeight="Bold" FontSize="19" VerticalAlignment="Center">LauncherBox</TextBlock></StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="Manage" Content="Manage Games" ToolTip="Manage games and sign-in startup (F2)"/><Button x:Name="Screen" Margin="7,0,0,0" Content="Fullscreen" ToolTip="Toggle fullscreen (F11)"/><Button x:Name="Quit" Margin="7,0,0,0" Content="Exit"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Row="1" Margin="0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel HorizontalAlignment="Center" Margin="0,4,0,10"><TextBlock x:Name="Counter" FontFamily="Consolas" FontSize="15" Foreground="#9EDDCB" HorizontalAlignment="Center"/><TextBlock x:Name="GameName" FontWeight="Bold" FontSize="36" TextTrimming="CharacterEllipsis" TextAlignment="Center"/></StackPanel>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
    <Button x:Name="Previous" Height="56" Margin="0,0,8,0" Padding="0" ToolTip="Previous game (←)" AutomationProperties.Name="Previous game"><Path Stroke="#BDE5DB" StrokeThickness="2.5" Data="M 13,2 L 3,12 L 13,22"/></Button>
    <Border Grid.Column="1" CornerRadius="10" Background="#132B36" BorderBrush="#477078" BorderThickness="1" Padding="7"><Border Background="#07121C" CornerRadius="4" ClipToBounds="True"><Grid><TextBlock x:Name="EmptyCover" Text="No screenshot added" Foreground="#A9BBC2" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="Cover" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Game screenshot"/></Grid></Border></Border>
    <Button x:Name="Next" Grid.Column="2" Height="56" Margin="8,0,0,0" Padding="0" ToolTip="Next game (→)" AutomationProperties.Name="Next game"><Path Stroke="#BDE5DB" StrokeThickness="2.5" Data="M 3,2 L 13,12 L 3,22"/></Button>
   </Grid>
   <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,13,0,4"><Button x:Name="Play" Background="#A3EAD3" Foreground="#0D2629" BorderBrush="#C1F2E3" Padding="30,8" FontWeight="Bold" FontSize="17"/><TextBlock x:Name="Status" Margin="0,5,0,0" TextAlignment="Center" Foreground="#A9BBC2" FontSize="12"/></StackPanel>
  </Grid>
  <Border Grid.Row="2" BorderBrush="#253944" BorderThickness="0,1,0,0" Padding="0,9,0,0"><DockPanel><TextBlock x:Name="LibraryCount" Foreground="#B4CBCB" FontSize="12"/><TextBlock Text="←  →  Browse games     ·     Enter  Play     ·     F11  Fullscreen" HorizontalAlignment="Right" Foreground="#9AAEB6" FontSize="12"/></DockPanel></Border>
 </Grid>
</Window>
