<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LauncherBox" Width="1160" Height="760" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen" Background="Black" Foreground="White"
        FontSize="18" UseLayoutRounding="True">
  <Grid Margin="24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Button x:Name="Power" HorizontalAlignment="Left" Width="48" Height="48"
            ToolTip="Power menu" AutomationProperties.Name="Power menu">
      <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="25" Text="&#xE7E8;"/>
    </Button>
    <Button x:Name="Manage" HorizontalAlignment="Right" Width="48" Height="48"
            ToolTip="Settings (F2 by default)" AutomationProperties.Name="Settings">
      <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="25" Text="&#xE713;" />
    </Button>
    <TextBlock x:Name="GameName" Grid.Row="1" Foreground="{DynamicResource Accent}"
               FontSize="46" Margin="12,0,12,16"
               TextTrimming="CharacterEllipsis" TextAlignment="Center"/>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="76"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="76"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="Previous" VerticalAlignment="Center" Height="84"
              ToolTip="Previous game" AutomationProperties.Name="Previous game">
        <Path Data="{DynamicResource NavigationChevron}" Width="36" Height="50" Stretch="Uniform"
              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
      <Button x:Name="StartGame" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0"
              ToolTip="Start game" AutomationProperties.Name="Start game">
        <Grid>
          <Image x:Name="Cover" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="START" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Source, ElementName=Cover}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Button>
      <TextBlock x:Name="EmptyLibrary" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="#A8A8A8" TextAlignment="Center" TextWrapping="Wrap"
                 Text="No games. Open Settings to add a game."/>
      <Button x:Name="Next" Grid.Column="2" VerticalAlignment="Center" Height="84"
              ToolTip="Next game" AutomationProperties.Name="Next game">
        <Path Data="{DynamicResource NavigationChevron}" Width="36" Height="50" Stretch="Uniform"
              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
          <Path.LayoutTransform><ScaleTransform ScaleX="-1"/></Path.LayoutTransform>
        </Path>
      </Button>
    </Grid>

    <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,8,0,0">
      <Button x:Name="GameSetting" Content="Game Settings" HorizontalAlignment="Center" FontSize="24"/>
      <TextBlock x:Name="Status" Margin="0,4,0,0" TextAlignment="Center" Foreground="#A8A8A8"/>
    </StackPanel>
  </Grid>
</Window>
